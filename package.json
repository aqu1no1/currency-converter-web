{
  "name": "currency-converter-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "lint:fix": "oxlint --fix --type-aware src/ test/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "pr": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:cov && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/react-query": "^5.104.2",
    "apexcharts": "^7.7.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "i18next": "^26.4.5",
    "react": "^19.3.1",
    "react-apexcharts": "^2.1.1",
    "react-data-table-component": "^7.7.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.4.2"
}
